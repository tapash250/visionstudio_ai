# Database
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/visionstudio

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Auth
# Required, 32+ random chars: openssl rand -hex 32 (the API refuses to start without it)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Storage (Cloudflare R2 / AWS S3)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=visionstudio-media
R2_PUBLIC_URL=

# Provider credentials at rest (Fernet key; generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())')
# Keep stable across API replicas and backups; never commit the generated value.
PROVIDER_ENCRYPTION_KEY=

# AI GPU Workers
GPU_WORKER_URL=http://gpu-worker:8001
# Shared secret between the Celery workers and the GPU worker (openssl rand -hex 32)
GPU_WORKER_TOKEN=
RUNPOD_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Moderation
MODERATION_ENABLED=true
AWS_REKOGNITION_ACCESS_KEY=
AWS_REKOGNITION_SECRET_KEY=

# App
ENV=development
CORS_ORIGINS=http://localhost:3000,https://visionstudio.app
# Host headers the API accepts ("*" is refused in production)
ALLOWED_HOSTS=localhost,127.0.0.1
# Hosts user-supplied media URLs may point at (R2_PUBLIC_URL's host is always allowed)
ALLOWED_MEDIA_HOSTS=
# Reverse proxies in front of the API that append X-Forwarded-For (0 = use the peer address)
TRUSTED_PROXY_COUNT=0
# Optional: seed an admin account with `python seed.py` (no default password)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
MAX_UPLOAD_SIZE=50
RATE_LIMIT_RPM=60
