# VisionStudio AI — Root Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# FRONTEND
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-32-character-random-string

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# BACKEND
# ============================================
DATABASE_URL=postgresql+asyncpg://visionstudio:visionstudio@localhost:5432/visionstudio
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Required, 32+ random chars: openssl rand -hex 32 (the API refuses to start without it)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Storage (Cloudflare R2)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=visionstudio-media
R2_PUBLIC_URL=

# GPU Worker
GPU_WORKER_URL=http://localhost:8001
# Shared secret between the Celery workers and the GPU worker (openssl rand -hex 32)
GPU_WORKER_TOKEN=

# Moderation
MODERATION_ENABLED=true

# App
ENV=development
CORS_ORIGINS=http://localhost:3000,https://visionstudio.app
# Host headers the API accepts ("*" is refused in production)
ALLOWED_HOSTS=localhost,127.0.0.1
# Hosts user-supplied media URLs may point at (R2_PUBLIC_URL's host is always allowed)
ALLOWED_MEDIA_HOSTS=
# Reverse proxies in front of the API that append X-Forwarded-For (0 = use the peer address)
TRUSTED_PROXY_COUNT=0
# Optional: seed an admin account with `python seed.py` (no default password)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
MAX_UPLOAD_SIZE=50
RATE_LIMIT_RPM=60

# ============================================
# GPU WORKER
# ============================================
CUDA_VISIBLE_DEVICES=0
HF_HOME=/app/cache
