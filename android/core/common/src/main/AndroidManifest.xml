<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Android 10+ saves to Pictures/ and Movies/ through MediaStore with no permission.
      Android 8–9 has no scoped storage, so writing to the shared folders needs this (and only there).
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application>
        <!-- Lets other apps read a generated file through the share sheet without exposing app storage. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/visionstudio_file_paths" />
        </provider>
    </application>
</manifest>
